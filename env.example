# ====================================================================
# SmartFinances Bot — Environment Variables
# Copy this file to .env and fill in the values
# ====================================================================

# --- Telegram ---
# Get your token from @BotFather on Telegram
# ⚠️  NEVER use the production bot token for local dev — create a separate test bot!
TELEGRAM_BOT_TOKEN=

# --- OpenAI ---
# Required. Used for:
#   - LLM parsing of user messages (cascade: gpt-4o-mini → gpt-4o)
#   - LLM-powered financial analysis (gpt-4o)
#   - Speech-to-text for voice messages (whisper-1)
# Same key is reused everywhere.
OPENAI_API_KEY=

# --- Database ---
# SQLite (default, local dev):
DATABASE_URL=sqlite:///./smartfinances.db
# SQLite (Docker / prod path):
# DATABASE_URL=sqlite:////app/data/smartfinances.db

# --- Logging ---
LOG_LEVEL=INFO

# --- Sentry (optional, recommended for prod) ---
# Get DSN at https://sentry.io → project settings → Client Keys
SENTRY_DSN=
# ENV is attached to every Sentry event as a tag ("dev", "staging", "prod")
ENV=dev

# --- Admin access for /admin_stats ---
# Comma-separated Telegram user IDs that can run /admin_stats.
# Find your own id by talking to @userinfobot.
ADMIN_TG_IDS=

# --- Google Sheets integration ---
# Users link their OWN Google Sheet via /sheets command in the bot.
# The bot writes/reads it using a shared Service Account — users never share credentials with us.
#
# Setup (one-time, per deployment):
# 1) Google Cloud Console → New project
# 2) Enable "Google Sheets API"
# 3) IAM & Admin → Service Accounts → Create → download JSON key
# 4) Put the JSON key file next to this .env (or anywhere accessible)
# 5) Set the path below
#
# Users then share their spreadsheet with the service account email (shown in the JSON)
# and link it via /sheets <url> in the bot.
#
# On prod: key file is mounted into Docker at /app/google_credentials.json
GOOGLE_APPLICATION_CREDENTIALS=./google_credentials.json

# --- YooKassa (optional, card payments in RUB) ---
# Requires registered shop (ИП/самозанятый/ООО). Without these, only Telegram Stars
# is offered to users. Get credentials at https://yookassa.ru → Settings → Shop ID & Secret Key.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- YooKassa webhook server (optional) ---
# Run `python -m services.webhook_server` as a separate process behind HTTPS reverse proxy.
# Configure the webhook URL in YooKassa dashboard → Integrations → HTTP-notifications.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
