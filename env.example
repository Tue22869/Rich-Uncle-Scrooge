# ====================================================================
# SmartFinances Bot — Environment Variables
# Copy this file to .env and fill in the values
# ====================================================================

# --- Telegram ---
# Get your token from @BotFather on Telegram
# ⚠️  NEVER use the production bot token for local dev — create a separate test bot!
TELEGRAM_BOT_TOKEN=

# --- OpenAI ---
# Required. Used for LLM parsing (cascade: gpt-4o-mini → gpt-4o)
# and for LLM-powered financial analysis (gpt-4o)
OPENAI_API_KEY=

# --- Database ---
# SQLite (default, local dev):
DATABASE_URL=sqlite:///./smartfinances.db
# SQLite (Docker / prod path):
# DATABASE_URL=sqlite:////app/data/smartfinances.db

# --- SpeechFlow (speech-to-text for voice messages) ---
# Free demo plan: 30 min transcription total — rotate keys before they run out
# Sign up at https://speechflow.io → Dashboard → API Keys
SPEECHFLOW_KEY_ID=
SPEECHFLOW_KEY_SECRET=

# --- Logging ---
LOG_LEVEL=INFO

# --- Google Sheets integration ---
# Users link their own spreadsheet via the /sheets command in the bot.
#
# Auth option A (recommended): service account JSON key path
# 1) Create a project in Google Cloud Console
# 2) Enable Google Sheets API
# 3) Create a Service Account → download JSON key
# 4) Share the target spreadsheet with the service account email as "Editor"
GOOGLE_APPLICATION_CREDENTIALS=

# Auth option B: OAuth refresh token (no interactive browser flow — used in bot runtime)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
